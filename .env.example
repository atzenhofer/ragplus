# Copy to .env. Values shown are the defaults.

# LLM, any OpenAI-compatible endpoint. The key is read from DHINFRA_API_KEY or LLM_API_KEY.
LLM_BASE_URL=https://api.dhinfra.uni-graz.at/v1
LLM_MODEL=qwen3.5-397b
LLM_API_KEY=
# 1 for a reasoning model, so the answer arrives in `content`.
LLM_DISABLE_THINKING=1

# Embeddings. Base URL and key fall back to the LLM ones; a new model re-embeds the corpus.
EMBED_BACKEND=api
EMBED_MODEL=qwen3-embedding-8b
# EMBED_API_BASE=
# EMBED_API_KEY=
# EMBED_BATCH=128          # texts per request
# EMBED_BATCH_CHARS=64000  # characters per request
# EMBED_CONCURRENCY=8      # requests in flight
# EMBED_MAX_CHARS=16000    # each text is cut here
# EMBED_TIMEOUT=300
# EMBED_RETRIES=6          # on 429, 503 and timeouts
# Local embeddings: `uv sync --extra local-embed`, EMBED_BACKEND=local, a Hugging Face model id.
EMBED_DEVICE=auto

# Corpus. DDP_API_URL is required; DDP_WEB_URL adds a link to each document's page.
DDP_API_URL=
DDP_WEB_URL=
