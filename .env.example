# Copy to .env and fill in. Values shown are the defaults in ragplus/config.py.
# Any OpenAI-compatible endpoint works for both the LLM and the embeddings.

# --- LLM ---
LLM_BASE_URL=https://api.dhinfra.uni-graz.at/v1
LLM_MODEL=qwen3.5-397b
# qwen3.5 is a reasoning model; thinking is switched off so the answer arrives in `content`.
# Set to 0 for a model without a thinking mode.
LLM_DISABLE_THINKING=1
# Key: DHINFRA_API_KEY is read first, then LLM_API_KEY.
LLM_API_KEY=

# --- Embeddings ---
# api: an OpenAI-compatible /embeddings endpoint. Base URL and key fall back to the LLM ones.
# Changing the model re-embeds the corpus on the next start.
EMBED_BACKEND=api
EMBED_MODEL=qwen3-embedding-8b
# EMBED_API_BASE=
# EMBED_API_KEY=
# EMBED_BATCH=128

# local: sentence-transformers on this machine (`uv sync --extra local-embed`); the model is a
# Hugging Face id. auto uses a GPU when torch finds one.
#   EMBED_BACKEND=local
#   EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=auto
